{
  "name": "dflook-terraform-fmt-check",
  "description": "Check that Terraform configuration files are in canonical format",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "ncc build src/main.ts -o dist --minify",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testMatch": [
      "**/__tests__/**/*.spec.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/stubs/",
      "/vendor/"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "moduleNameMapper": {
      "^@core$": "<rootDir>/vendor/core/src/index.ts",
      "^@core/(.*)$": "<rootDir>/vendor/core/src/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@actions/core$": "<rootDir>/__tests__/stubs/actions-core.ts",
      "^@actions/exec$": "<rootDir>/__tests__/stubs/actions-exec.ts",
      "^@actions/tool-cache$": "<rootDir>/__tests__/stubs/actions-tool-cache.ts"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "verbatimModuleSyntax": false
          }
        }
      ]
    }
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0",
    "axios": "1.19.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.6",
    "@types/node": "^26.2.0",
    "@vercel/ncc": "0.44.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "5.8.3"
  },
  "type": "module"
}
